# Environment variables used by Hermes agents and scripts
# Do NOT commit secrets here. Copy to .env in your runtime and fill values.

# Anthropic API key (used for drafting, scoring, critique). If unset agents that
# rely on Anthropic will log and skip gracefully.
ANTHROPIC_API_KEY=

# CRM webhook target for social drafts (Hermes will POST generated drafts here)
CRM_WEBHOOK_URL=

# TMOS diffusion alert threshold (points vs prior month). Default 10.
TMOS_ALERT_POINTS=10

# Telegram chat id placeholder used in n8n workflows
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID
