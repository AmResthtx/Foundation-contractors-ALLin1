# Environment variables used by Hermes agents and scripts
# Do NOT commit secrets here. Copy to .env in your runtime and fill values.

NODE_ENV=production
LOG_LEVEL=info

# Anthropic API key (used for drafting, scoring, critique). If unset agents that
# rely on Anthropic will log and skip gracefully (content-pipeline drafts a
# placeholder, lead-scorer falls back to rule-based keyword scoring).
ANTHROPIC_API_KEY=

# Where Hermes stores state + the audit log (bind-mounted to ./data in Docker).
DB_PATH=./data

# CRM webhook target (n8n) for alerts, escalations, and social drafts. Hermes
# POSTs JSON here; see docs/N8N_TELEGRAM_SETUP.md.
CRM_WEBHOOK_URL=optional_n8n_webhook

# Escalation email fallback (Web3Forms) — used when a job fails 5x in a row
# or the watchdog restarts the process. Recipient is whoever the Web3Forms
# key is registered to.
WEB3FORMS_KEY=your_key
CRM_EMAIL=ellishuntersmith@gmail.com

# Content pipeline: when true, drafts run a second Anthropic critique pass
# against the cited KB text before the Policy 2 gate can pass (Policy 2).
KB_STRESS_TEST_MODE=true

# Steel PPI alert threshold — percent month-over-month move that triggers an
# alert (WPU101704 / PCU33123312, both price-level series).
PPI_ALERT_PCT=5

# TMOS diffusion-index alert threshold — points vs prior month (BACTSAMFRBDAL
# is a diffusion index, so this is a point move, not a percent — a sign flip
# always alerts regardless of this value).
TMOS_ALERT_POINTS=10

# RSS/Atom feeds for the local + statewide events watchers (optional — sane
# defaults are baked into hermes/agents/local-monitoring.js and
# statewide-monitoring.js). Comma separates sources; pipe | separates
# fallback candidate URLs for one source (first that fetches AND parses wins).
LOCAL_FEEDS=
STATEWIDE_FEEDS=

# Telegram chat id placeholder used in n8n workflows (set in the n8n UI, not
# actually read from here — kept for reference/documentation).
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# Approval callback receiver port (daemon mode only). n8n's draft-approval
# workflow POSTs approve/reject decisions to http://hermes:8787/callback/approval
# inside the compose network. Set to 0 to disable. Never publish this port.
CALLBACK_PORT=8787

# Reserved for future credential-at-rest needs; not yet wired to anything.
ENCRYPTION_KEY=will_be_generated
